    "isArchived": false,
    "nodes": [
      {
        "id": "webhook-health",
        "name": "Receive Health Check",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          0,
          300
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "health",
          "responseMode": "responseNode",
          "options": {}
        },
        "notes": "Health endpoint. No auth — reports only up/down of the dependency chain.",
        "webhookId": "e0675856-8e6d-42cd-aaab-6bc9a1324353"
      },
      {
        "id": "ping-anthropic",
        "name": "Ping Anthropic (Haiku)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          240,
          300
        ],
        "parameters": {
          "method": "POST",
          "url": "https://api.anthropic.com/v1/messages",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "anthropicApi",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "anthropic-version",
                "value": "2023-06-01"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 10,\n  \"messages\": [{ \"role\": \"user\", \"content\": \"ping\" }]\n}",
          "options": {
            "timeout": 15000
          }
        },
        "credentials": {
          "anthropicApi": {
            "id": "azRjMcNgGfj9c985",
            "name": "Anthropic account"
          }
        },
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 1000,
        "notes": "Trivial Haiku call proves Anthropic reachability + valid key. onError=continueRegularOutput so a dependency outage is REPORTED ('down'), not fatal. Cheapest model, max_tokens 10, 15s timeout, 2 retries.",
        "onError": "continueRegularOutput",
        "alwaysOutputData": true
      },
      {
        "id": "ping-supabase",
        "name": "Ping Supabase (REST Root)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          300
        ],
        "parameters": {
          "method": "GET",
          "url": "https://zocsluxabpnxmzjhwqky.supabase.co/rest/v1/",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "supabaseApi",
          "options": {
            "timeout": 10000
          }
        },
        "credentials": {
          "supabaseApi": {
            "id": "p3GvX0MPWFrCFb9i",
            "name": "Supabase account"
          }
        },
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 1000,
        "notes": "PostgREST root ping = DB reachable. SELECT NOW() deferred to M2 (no schema yet). onError=continueRegularOutput + alwaysOutputData capture failures. 10s timeout, 2 retries.",
        "onError": "continueRegularOutput",
        "alwaysOutputData": true
      },
      {
        "id": "build-response",
        "name": "Build Health Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          720,
          300
        ],
        "parameters": {
          "jsCode": "const a = $('Ping Anthropic (Haiku)').item.json;\nconst s = $('Ping Supabase (REST Root)').item.json;\nreturn [{ json: {\n  status: 'ok',\n  timestamp: new Date().toISOString(),\n  anthropic: (a && a.error) ? 'down' : 'reachable',\n  supabase: (s && s.error) ? 'down' : 'reachable'\n} }];"
        },
        "notes": "Combines both dependency results. A node that failed (onError) surfaces an 'error' key => 'down'."
      },
      {
        "id": "respond-health",
        "name": "Respond Health Check",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          960,
          300
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $json }}"
        },
        "notes": "Returns combined health JSON to the caller."
      }
    ],
    "connections": {
      "Receive Health Check": {
